# Copy thành .env rồi sửa:  cp .env.example .env
# Tạo key ngẫu nhiên:  openssl rand -hex 24
API_KEY=doi-thanh-chuoi-bi-mat

# Cổng public mà bạn sẽ gọi từ bên ngoài
HOST=0.0.0.0
PORT=8000

# Cổng nội bộ của ComfyUI (không mở ra ngoài)
COMFY_PORT=8188

# Text encoder nhẹ hơn (5.3 GB thay vì 7.5 GB) nếu thiếu RAM/đĩa:
# TEXT_ENCODER_NAME=qwen_3_4b_fp8_mixed.safetensors

# Driver NVIDIA cũ (CUDA < 12.8) thì đổi sang cu126 hoặc cu124:
# TORCH_INDEX=https://download.pytorch.org/whl/cu126

# Thêm tham số cho ComfyUI, ví dụ khi thiếu VRAM:
# COMFY_ARGS=--lowvram

# Server ở Trung Quốc/khó tải từ Hugging Face thì dùng mirror:
# HF_ENDPOINT=https://hf-mirror.com
